# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# URL del proyecto (Project Settings → API). No es secreta.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (sb_secret_…) o, en proyectos antiguos, la service_role key.
# SOLO servidor: no le pongas el prefijo NEXT_PUBLIC_ o acabaría en el navegador.
SUPABASE_SECRET_KEY=

# Opcional. Los endpoints /api/supabase/* se desactivan en producción porque el
# proyecto no tiene autenticación. Pon "true" solo tras añadir autenticación.
# ETL_PERMITIR_EN_PRODUCCION=false
